@using IdentityRiskAnalyzer.Web.Domain.Enums
@model IdentityRiskAnalyzer.Web.ViewModels.AccountDetailsViewModel
@{
    ViewData["Title"] = $"Historical Account: {Model.AccountName}";
    string StatusText(bool? value) => value switch { true => "Yes", false => "No", _ => "Unknown" };
    string SeverityClass(RiskSeverity severity) => severity switch
    {
        RiskSeverity.Critical => "text-bg-danger",
        RiskSeverity.High => "text-bg-warning",
        RiskSeverity.Medium => "text-bg-info",
        _ => "text-bg-secondary"
    };
    string DelegationName(DelegationType type) => type switch
    {
        DelegationType.Unconstrained => "Unconstrained Delegation",
        DelegationType.Constrained => "Constrained Delegation",
        DelegationType.ProtocolTransition => "Protocol Transition",
        DelegationType.ResourceBasedConstrained => "Resource-Based Constrained Delegation",
        _ => type.ToString()
    };
}

<nav aria-label="Breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Scans" asp-action="Details" asp-route-id="@Model.ScanRunId">Scan #@Model.ScanRunId</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.AccountName</li>
    </ol>
</nav>

<div class="alert alert-info" role="status">
    <strong>Historical snapshot from Scan #@Model.ScanRunId</strong> · @Model.ScanTimestampUtc.ToString("dd MMM yyyy HH:mm 'UTC'") · @Model.ScanStatus
    <div class="small">This page shows saved results from that scan, not the current Active Directory state.</div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="mb-1">@Model.AccountName</h1>
        <div><strong>SAM Account Name:</strong> @(Model.SamAccountName ?? "Not available")</div>
        <div><strong>UPN:</strong> @(Model.UserPrincipalName ?? "Not available")</div>
        <div class="text-muted text-break"><strong>DN:</strong> @Model.DistinguishedName</div>
    </div>
    <div class="card shadow-sm border-0 bg-light"><div class="card-body">
        <div class="text-muted">Account Risk Score</div>
        <div class="display-5 fw-bold">@Model.RiskScore <span class="fs-5 fw-normal">/ 100</span></div>
        <span class="badge @SeverityClass(Model.RiskLevel)">@Model.RiskLevel</span>
    </div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4"><section class="card h-100"><div class="card-body">
        <h2 class="h5">Account Status</h2>
        <dl class="row mb-0">
            <dt class="col-7">Enabled</dt><dd class="col-5">@StatusText(Model.Enabled)</dd>
            <dt class="col-7">Locked</dt><dd class="col-5">@StatusText(Model.Locked)</dd>
            <dt class="col-7">Expired</dt><dd class="col-5">@StatusText(Model.AccountExpired)</dd>
        </dl>
    </div></section></div>
    <div class="col-lg-4"><section class="card h-100"><div class="card-body">
        <h2 class="h5">Activity &amp; Password</h2>
        <dl class="mb-0">
            <dt>Last known activity</dt><dd>@(Model.LastKnownActivityUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Not available")</dd>
            <dt>Password last set</dt><dd>@(Model.PasswordLastSetUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Not available")</dd>
            <dt>Password never expires</dt><dd>@StatusText(Model.PasswordNeverExpires)</dd>
        </dl>
    </div></section></div>
    <div class="col-lg-4"><section class="card h-100"><div class="card-body">
        <h2 class="h5">Identity</h2>
        <dl class="mb-0">
            <dt>Object type</dt><dd>@Model.ObjectType</dd>
            <dt>SID</dt><dd class="text-break">@(Model.Sid ?? "Not available")</dd>
            <dt>Service Account</dt><dd>@(Model.IsServiceAccount ? "Yes" : "No")</dd>
            <dt>Privileged</dt><dd>@(Model.IsPrivileged ? "Yes" : "No")</dd>
        </dl>
    </div></section></div>
</div>

<section class="card shadow-sm mb-4" aria-labelledby="breakdown-heading"><div class="card-body">
    <h2 id="breakdown-heading" class="h4">Risk Score Breakdown</h2>
    <p class="text-muted">Contributions come from findings saved in this ScanRun. The final Account Risk Score and Risk Level are the saved snapshot values.</p>
    @if (Model.FindingsCount > 0)
    {
        <div class="table-responsive"><table class="table table-sm">
            <thead><tr><th>Rule ID</th><th>Finding</th><th>Contribution</th></tr></thead>
            <tbody>
            @foreach (var finding in Model.Findings)
            {
                <tr><td>@finding.RuleId</td><td>@finding.Title</td><td>+@finding.ScoreContribution</td></tr>
            }
            </tbody>
        </table></div>
    }
    <div><strong>Accumulated points:</strong> @Model.AccumulatedPoints</div>
    <div><strong>Final Account Risk Score:</strong> @Model.RiskScore / 100</div>
    @if (Model.WasCapped)
    {
        <div class="text-muted">Accumulated points exceed 100; scoring caps the result at 100. The final value above is the saved historical score.</div>
    }
</div></section>

<section class="card shadow-sm mb-4" aria-labelledby="privilege-heading"><div class="card-body">
    <h2 id="privilege-heading" class="h4">Privileged Memberships</h2>
    @if (Model.PrivilegeMemberships.Count == 0)
    {
        <p class="text-muted mb-0">No privileged group memberships were recorded for this object in this scan.</p>
    }
    else
    {
        @foreach (var membership in Model.PrivilegeMemberships)
        {
            <div class="border rounded p-3 mb-3">
                <h3 class="h5">@membership.GroupName</h3>
                <div><strong>Type:</strong> @(membership.IsDirect ? "Direct membership" : "Nested membership")</div>
                <div><strong>Depth:</strong> @membership.Depth</div>
                <div class="mt-2"><strong>Privilege path:</strong><br /><partial name="_MembershipPath" model="membership" /></div>
            </div>
        }
    }
</div></section>

<section class="card shadow-sm mb-4" aria-labelledby="delegation-heading"><div class="card-body">
    <h2 id="delegation-heading" class="h4">Kerberos Delegation</h2>
    @if (Model.DelegationRecords.Count == 0)
    {
        <p class="text-muted mb-0">No Kerberos delegation configuration was recorded for this object in this scan.</p>
    }
    else
    {
        @foreach (var delegation in Model.DelegationRecords)
        {
            <div class="border rounded p-3 mb-3">
                <h3 class="h5">@DelegationName(delegation.DelegationType)</h3>
                @if (!delegation.TargetsAvailable)
                {
                    <p class="text-warning mb-0">Target data could not be parsed.</p>
                }
                else if (delegation.Targets.Count == 0)
                {
                    <p class="text-muted mb-0">Targets: Not recorded or not applicable.</p>
                }
                else
                {
                    <div><strong>Targets:</strong></div>
                    <ul class="mb-0">@foreach (var target in delegation.Targets) { <li class="text-break">@target</li> }</ul>
                }
                @if (delegation.DelegationType == DelegationType.ResourceBasedConstrained)
                {
                    <p class="small text-muted mt-2 mb-0">Detailed ACL analysis was not performed in this MVP.</p>
                }
            </div>
        }
    }
</div></section>

<section class="card shadow-sm mb-4" aria-labelledby="findings-heading"><div class="card-body">
    <h2 id="findings-heading" class="h4">Risk Findings <span class="text-muted fs-6">(@Model.FindingsCount)</span></h2>
    @if (Model.FindingsCount == 0)
    {
        <p class="text-muted mb-0">No risks were detected by the rules enabled for this scan.</p>
    }
    else
    {
        @foreach (var finding in Model.Findings)
        {
            <article class="border rounded p-3 mb-3">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <span class="badge @SeverityClass(finding.Severity)">@finding.Severity</span>
                    <span class="font-monospace">@finding.RuleId</span>
                    <span class="text-muted">@finding.Category</span>
                    <span class="ms-auto">Risk points: @finding.RiskPoints</span>
                </div>
                <h3 class="h5">@finding.Title</h3>
                <p>@finding.Description</p>
                <h4 class="h6">Evidence</h4>
                <p class="text-break" style="white-space: pre-wrap">@(finding.Evidence ?? "No evidence text was saved.")</p>
                <div class="bg-light rounded p-2"><strong>Recommended action</strong><div class="text-break" style="white-space: pre-wrap">@finding.Recommendation</div></div>
            </article>
        }
    }
</div></section>

<section class="card shadow-sm mb-4" aria-labelledby="memberships-heading"><div class="card-body">
    <h2 id="memberships-heading" class="h4">Group Memberships <span class="text-muted fs-6">(@Model.GroupMembershipCount)</span></h2>
    <p class="text-muted">Direct and nested memberships saved in this scan, including privileged groups. Page @Model.MembershipPage of @Model.MembershipPageCount.</p>
    @if (Model.GroupMembershipCount == 0)
    {
        <p class="text-muted mb-0">No group memberships were recorded for this object in this scan.</p>
    }
    else
    {
        <div class="table-responsive"><table class="table table-striped table-sm align-middle">
            <thead><tr><th>Group</th><th>Type</th><th>Depth</th><th>Path</th></tr></thead>
            <tbody>
            @foreach (var membership in Model.GroupMemberships)
            {
                <tr>
                    <td>@membership.GroupName @if (membership.IsPrivileged) { <span class="badge text-bg-warning">Privileged</span> }</td>
                    <td>@(membership.IsDirect ? "Direct" : "Nested")</td>
                    <td>@membership.Depth</td>
                    <td><partial name="_MembershipPath" model="membership" /></td>
                </tr>
            }
            </tbody>
        </table></div>
        @if (Model.MembershipPageCount > 1)
        {
            <nav aria-label="Group membership pages" class="d-flex gap-2">
                @if (Model.MembershipPage > 1)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="ScanObjects" asp-action="Details" asp-route-scanId="@Model.ScanRunId" asp-route-objectGuid="@Model.ObjectGuid" asp-route-page="@(Model.MembershipPage - 1)">Previous</a>
                }
                @if (Model.MembershipPage < Model.MembershipPageCount)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="ScanObjects" asp-action="Details" asp-route-scanId="@Model.ScanRunId" asp-route-objectGuid="@Model.ObjectGuid" asp-route-page="@(Model.MembershipPage + 1)">Next</a>
                }
            </nav>
        }
    }
</div></section>
