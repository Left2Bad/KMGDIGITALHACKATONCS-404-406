@model IdentityRiskAnalyzer.Web.ViewModels.ScanListViewModel
@{
    ViewData["Title"] = "Scans";
}

<h1>Active Directory scans</h1>
<p class="text-muted">Each completed scan is a separate SQLite snapshot. Start runs in this request and may take several minutes.</p>
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-warning" role="alert">@Model.Message</div>
}
<form asp-controller="Scans" asp-action="Start" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">Start Scan</button>
</form>
<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead><tr><th>ID</th><th>Started (UTC)</th><th>Finished (UTC)</th><th>Status</th><th>Server</th><th>Objects</th><th>Findings</th><th>Errors</th><th>AD Security Score</th><th>Duration</th></tr></thead>
        <tbody>
        @foreach (var scan in Model.Scans)
        {
            <tr>
                <td><a asp-controller="Scans" asp-action="Details" asp-route-id="@scan.Id">@scan.Id</a></td>
                <td>@scan.StartedAtUtc.ToString("u")</td>
                <td>@(scan.FinishedAtUtc?.ToString("u") ?? "—")</td>
                <td>@scan.Status</td><td>@scan.Server</td><td>@scan.ObjectsScanned</td>
                <td>@scan.FindingsCount</td><td>@scan.ErrorsCount</td>
                <td>@(scan.AdSecurityScore?.ToString() ?? "—")</td>
                <td>@(scan.Duration?.ToString(@"hh\:mm\:ss") ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
