@model IdentityRiskAnalyzer.Web.ViewModels.ActiveDirectoryConnectionViewModel
@{
    ViewData["Title"] = "Active Directory";
}

<h1>Active Directory connection</h1>
<p class="text-muted">Review the configured LDAP endpoint and test whether it can be reached.</p>

<dl class="row">
    <dt class="col-sm-3">Server</dt>
    <dd class="col-sm-9">@Model.Server</dd>

    <dt class="col-sm-3">Port</dt>
    <dd class="col-sm-9">@Model.Port</dd>

    <dt class="col-sm-3">Connection security</dt>
    <dd class="col-sm-9">@Model.Protocol</dd>

    <dt class="col-sm-3">Base DN</dt>
    <dd class="col-sm-9">@Model.BaseDn</dd>

    <dt class="col-sm-3">Timeout</dt>
    <dd class="col-sm-9">@Model.TimeoutSeconds seconds</dd>

    <dt class="col-sm-3">Credentials configured</dt>
    <dd class="col-sm-9">@(Model.CredentialsConfigured ? "Yes" : "No — current identity will be used")</dd>
</dl>

@if (Model.Protocol == "LDAP")
{
    <div class="alert alert-info" role="status">LDAP transport is not protected by LDAPS/TLS. Configure a trusted DC certificate and use LDAPS on port 636 when available.</div>
}

<form asp-controller="ActiveDirectory" asp-action="TestConnection" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">Test Connection</button>
</form>

<p class="mt-3">
    <a asp-controller="ActiveDirectory" asp-action="Users" class="btn btn-outline-secondary">Read users</a>
    <a asp-controller="ActiveDirectory" asp-action="Groups" class="btn btn-outline-secondary">Read groups</a>
</p>

@if (Model.TestResult is { } result)
{
    <div class="alert @(result.Success ? "alert-success" : "alert-danger") mt-4" role="alert">
        <h2 class="h5">@(result.Success ? (result.UseSsl ? "LDAPS connection succeeded" : "LDAP connection succeeded") : "Connection failed")</h2>
        <p class="mb-1">@result.Message</p>
        @if (result.Success)
        {
            <div>Server: @result.Server</div>
            <div>Port: @result.Port</div>
            <div>Protocol: @(result.UseSsl ? "LDAPS" : "LDAP")</div>
            <div>TLS: @(result.UseSsl ? "Enabled" : "Disabled")</div>
            <div>Duration: @result.DurationMs ms</div>
        }
    </div>
}
